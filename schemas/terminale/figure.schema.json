{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "terminale/figure.schema.json",
  "title": "Figure (terminale)",
  "description": "Figure d'un bloc de cours ou d'un exercice de terminale. Même forme que schemas/figure.schema.json (première), pour que FigureRenderer l'affiche tel quel, mais le chemin d'une image a trois niveaux : terminale/<matiere>/<chapitre>/<nom>.<ext>, sous public/figures/ (charte § 2). Le schéma de première n'est pas modifié.",
  "type": "object",
  "required": ["type", "data"],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": ["image", "tree"]
    },
    "data": {
      "type": "object"
    },
    "caption": {
      "type": "string",
      "description": "Légende affichée sous la figure (texte simple, pas de LaTeX)."
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": { "const": "image" },
        "data": {
          "type": "object",
          "required": ["src", "alt"],
          "additionalProperties": false,
          "properties": {
            "src": {
              "type": "string",
              "pattern": "^terminale/(maths|physique-chimie)/[a-z0-9]+(-[a-z0-9]+)*/[a-zA-Z0-9._-]+\\.(svg|png|webp|jpg|jpeg)$",
              "description": "Chemin relatif sous public/figures/. Ex. : terminale/maths/limites-suites/suite-croissante.svg"
            },
            "alt": {
              "type": "string",
              "minLength": 3,
              "description": "Texte alternatif parlant (ce que montre la figure). Obligatoire."
            },
            "width": { "type": "integer", "minimum": 50, "maximum": 1200 },
            "height": { "type": "integer", "minimum": 50, "maximum": 1200 }
          }
        }
      }
    },
    {
      "properties": {
        "type": { "const": "tree" },
        "data": {
          "type": "object",
          "required": ["root"],
          "additionalProperties": false,
          "properties": {
            "root": { "$ref": "#/$defs/treeNode" },
            "orientation": { "type": "string", "enum": ["horizontal", "vertical"] }
          }
        }
      }
    }
  ],
  "$defs": {
    "treeNode": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string", "description": "Étiquette du nœud (LaTeX inline possible)." },
        "weight": { "type": "string", "description": "Étiquette de l'arête qui mène au nœud (absente pour la racine)." },
        "children": { "type": "array", "items": { "$ref": "#/$defs/treeNode" } }
      }
    }
  }
}
